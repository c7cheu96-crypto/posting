{
  "manifest_version": 3,
  "name": "블로그 글 채워넣기 (posting)",
  "version": "0.1.0",
  "description": "GitHub posting 저장소에 자동으로 써진 글을 네이버 블로그 에디터에 채워 넣어요.",
  "permissions": ["storage", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://blog.naver.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "블로그 글 채워넣기"
  },
  "content_scripts": [
    {
      "matches": ["https://blog.naver.com/*"],
      "js": ["naver.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
